# Restore the original PHP preview app as the directory entry point.
DirectoryIndex index.php index.html
Options -Indexes
<Files "config.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>
