{
  "name": "CourseMaterial",
  "type": "object",
  "properties": {
    "course_id": {
      "type": "string"
    },
    "course_code": {
      "type": "string"
    },
    "professor_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "lecture_notes",
        "presentation",
        "syllabus",
        "reading",
        "dataset",
        "other"
      ],
      "enumColors": [
        "blue",
        "purple",
        "pink",
        "green",
        "yellow",
        "gray"
      ],
      "default": "reading"
    },
    "description": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "published": {
      "type": "boolean",
      "default": false
    },
    "uploaded_at": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "course_id",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.published": true
        },
        {
          "user_condition": {
            "role": "professor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dean"
          }
        },
        {
          "user_condition": {
            "role": "academic_staff"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "professor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "professor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "professor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}