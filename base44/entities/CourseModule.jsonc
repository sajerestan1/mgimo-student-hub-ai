{
  "name": "CourseModule",
  "type": "object",
  "properties": {
    "course_id": {
      "type": "string"
    },
    "course_code": {
      "type": "string"
    },
    "course_title": {
      "type": "string"
    },
    "module_number": {
      "type": "number"
    },
    "title": {
      "type": "string"
    },
    "introduction": {
      "type": "string"
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lecture_topic": {
      "type": "string"
    },
    "lecture_notes": {
      "type": "string"
    },
    "readings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "activity": {
      "type": "string"
    },
    "duration_hours": {
      "type": "number",
      "default": 4
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "enumColors": [
        "gray",
        "green"
      ],
      "default": "published"
    },
    "professor_id": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "course_id",
    "module_number",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "published"
        },
        {
          "user_condition": {
            "role": "professor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dean"
          }
        },
        {
          "user_condition": {
            "role": "deputy_dean"
          }
        },
        {
          "user_condition": {
            "role": "academic_staff"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "professor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "professor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "professor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}