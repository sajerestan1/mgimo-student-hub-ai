{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "actor_name": {
      "type": "string"
    },
    "actor_role": {
      "type": "string"
    },
    "actor_user_id": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "target_user_id": {
      "type": "string"
    },
    "details": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "success",
        "failure",
        "denied"
      ],
      "enumColors": [
        "green",
        "red",
        "yellow"
      ],
      "default": "success"
    },
    "logged_at": {
      "type": "string"
    }
  },
  "required": [
    "action"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}