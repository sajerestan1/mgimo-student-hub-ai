{
  "name": "Grade",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "course_code": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "instructor": {
      "type": "string"
    },
    "credits": {
      "type": "number"
    },
    "grade": {
      "type": "string"
    },
    "grade_points": {
      "type": "number"
    },
    "type": {
      "type": "string",
      "enum": [
        "exam",
        "credit",
        "coursework"
      ],
      "enumColors": [
        "blue",
        "green",
        "purple"
      ]
    },
    "semester": {
      "type": "string"
    },
    "date": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}