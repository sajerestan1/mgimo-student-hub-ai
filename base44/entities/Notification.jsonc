{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "announcement",
        "schedule",
        "application",
        "reminder",
        "deadline",
        "message",
        "official",
        "security"
      ],
      "enumColors": [
        "blue",
        "purple",
        "green",
        "yellow",
        "red",
        "blue",
        "yellow",
        "pink"
      ]
    },
    "notification_type": {
      "type": "string"
    },
    "link": {
      "type": "string"
    },
    "dedupe_key": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean"
    },
    "due_date": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}