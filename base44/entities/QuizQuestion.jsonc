{
  "name": "QuizQuestion",
  "type": "object",
  "properties": {
    "quiz_id": {
      "type": "string"
    },
    "course_id": {
      "type": "string"
    },
    "prompt": {
      "type": "string"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "correct_index": {
      "type": "number",
      "default": 0
    },
    "points": {
      "type": "number",
      "default": 1
    },
    "order": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "quiz_id",
    "prompt"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "professor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "professor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "professor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}