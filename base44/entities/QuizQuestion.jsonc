{
  "name": "QuizQuestion",
  "type": "object",
  "properties": {
    "quiz_id": {
      "type": "string"
    },
    "course_id": {
      "type": "string"
    },
    "module_id": {
      "type": "string"
    },
    "module_number": {
      "type": "number"
    },
    "prompt": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "multiple_choice",
        "multiple_select",
        "true_false",
        "short_answer",
        "essay"
      ],
      "enumColors": [
        "blue",
        "purple",
        "green",
        "yellow",
        "pink"
      ],
      "default": "multiple_choice"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "correct_index": {
      "type": "number",
      "default": 0
    },
    "correct_answers": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "explanation": {
      "type": "string"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ],
      "enumColors": [
        "green",
        "yellow",
        "red"
      ],
      "default": "medium"
    },
    "points": {
      "type": "number",
      "default": 1
    },
    "order": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "quiz_id",
    "prompt"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "professor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "professor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "professor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}