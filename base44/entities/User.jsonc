{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "Assigned by an administrator. Users cannot change their own role.",
      "enum": [
        "admin",
        "dean",
        "deputy_dean",
        "faculty_admin",
        "department_head",
        "professor",
        "academic_staff",
        "student",
        "user"
      ],
      "enumColors": [
        "red",
        "blue",
        "purple",
        "green",
        "yellow",
        "pink",
        "gray",
        "blue",
        "gray"
      ],
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "admin_level": {
      "type": "string",
      "description": "Distinguishes a Super Administrator from a standard Administrator",
      "enum": [
        "super",
        "standard"
      ],
      "enumColors": [
        "red",
        "blue"
      ],
      "default": "standard",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "account_status": {
      "type": "string",
      "description": "Suspended and deactivated accounts cannot use the application",
      "enum": [
        "active",
        "suspended",
        "deactivated"
      ],
      "enumColors": [
        "green",
        "yellow",
        "red"
      ],
      "default": "active",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "provisioned": {
      "type": "boolean",
      "description": "True only for accounts created by an administrator through institutional provisioning",
      "default": false,
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "phone": {
      "type": "string"
    },
    "contact_email": {
      "type": "string",
      "description": "Institutional email, kept in step with the sign-in address by an administrator",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "photo_uri": {
      "type": "string",
      "description": "Private storage URI of the profile photo"
    },
    "student_id": {
      "type": "string",
      "description": "Official student number, assigned by an administrator",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "professor_id": {
      "type": "string",
      "description": "Official professor number, assigned by an administrator",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "group_name": {
      "type": "string",
      "description": "Class / study group, assigned by an administrator",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "programme": {
      "type": "string",
      "description": "Academic programme, assigned by an administrator",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "faculty_id": {
      "type": "string",
      "description": "Faculty scope, assigned by an administrator",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "department_id": {
      "type": "string",
      "description": "Department scope, assigned by an administrator",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "username": {
      "type": "string",
      "description": "Institutional account alias, stored lowercase and unique across every account. Assigned and changed by an administrator only; it never grants a role or permission.",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "username_updated_at": {
      "type": "string",
      "description": "When the alias was last assigned or changed",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "username_assigned_by": {
      "type": "string",
      "description": "Administrator who last assigned the alias",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "profile_completed": {
      "type": "boolean",
      "default": false
    },
    "last_login_at": {
      "type": "string"
    }
  },
  "required": [
    "role"
  ]
}