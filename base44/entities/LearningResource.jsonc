{
  "name": "LearningResource",
  "type": "object",
  "properties": {
    "course_id": {
      "type": "string"
    },
    "course_code": {
      "type": "string"
    },
    "module_id": {
      "type": "string"
    },
    "module_number": {
      "type": "number"
    },
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "lecture_notes",
        "slides",
        "reading",
        "study_guide",
        "case_study",
        "research_summary",
        "seminar_prep",
        "revision_guide"
      ],
      "enumColors": [
        "blue",
        "purple",
        "green",
        "yellow",
        "pink",
        "gray",
        "blue",
        "red"
      ],
      "default": "reading"
    },
    "description": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "reading_list": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "published_date": {
      "type": "string"
    },
    "professor_id": {
      "type": "string"
    },
    "visible_to_students": {
      "type": "boolean",
      "default": true
    },
    "is_demo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "course_id",
    "title",
    "type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.visible_to_students": true
        },
        {
          "user_condition": {
            "role": "professor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dean"
          }
        },
        {
          "user_condition": {
            "role": "deputy_dean"
          }
        },
        {
          "user_condition": {
            "role": "academic_staff"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "professor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "professor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "professor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}