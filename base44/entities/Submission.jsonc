{
  "name": "Submission",
  "type": "object",
  "properties": {
    "assignment_id": {
      "type": "string"
    },
    "course_id": {
      "type": "string"
    },
    "course_code": {
      "type": "string"
    },
    "professor_id": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "student_user_id": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "student_group": {
      "type": "string"
    },
    "submitted_at": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "graded",
        "returned"
      ],
      "enumColors": [
        "yellow",
        "green",
        "blue"
      ],
      "default": "submitted"
    },
    "score": {
      "type": "number"
    },
    "feedback": {
      "type": "string"
    },
    "graded_at": {
      "type": "string"
    },
    "graded_by": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "assignment_id",
    "course_id",
    "student_name",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.student_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "professor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dean"
          }
        },
        {
          "user_condition": {
            "role": "deputy_dean"
          }
        },
        {
          "user_condition": {
            "role": "academic_staff"
          }
        },
        {
          "user_condition": {
            "role": "faculty_admin"
          }
        },
        {
          "user_condition": {
            "role": "department_head"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.student_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "professor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "professor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dean"
          }
        },
        {
          "user_condition": {
            "role": "academic_staff"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "professor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}