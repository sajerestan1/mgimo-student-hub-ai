{
  "name": "AccountProvision",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Sign-in address the account is provisioned for"
    },
    "role": {
      "type": "string",
      "enum": [
        "student",
        "professor",
        "admin"
      ],
      "enumColors": [
        "blue",
        "pink",
        "red"
      ],
      "default": "student"
    },
    "full_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "faculty_id": {
      "type": "string"
    },
    "department_id": {
      "type": "string"
    },
    "group_name": {
      "type": "string"
    },
    "programme": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "professor_id": {
      "type": "string"
    },
    "account_status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "deactivated"
      ],
      "enumColors": [
        "green",
        "yellow",
        "red"
      ],
      "default": "active"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "applied",
        "cancelled"
      ],
      "enumColors": [
        "yellow",
        "green",
        "gray"
      ],
      "default": "pending"
    },
    "created_by_name": {
      "type": "string"
    },
    "created_by_user_id": {
      "type": "string"
    },
    "applied_user_id": {
      "type": "string"
    },
    "applied_at": {
      "type": "string"
    }
  },
  "required": [
    "email",
    "role",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}