{
  "name": "AttendanceRecord",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string"
    },
    "course_id": {
      "type": "string"
    },
    "faculty_id": {
      "type": "string"
    },
    "department_id": {
      "type": "string"
    },
    "session_date": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "present",
        "absent",
        "late",
        "excused"
      ],
      "enumColors": [
        "green",
        "red",
        "yellow",
        "blue"
      ],
      "default": "present"
    },
    "recorded_by": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "student_id",
    "session_date",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dean"
          }
        },
        {
          "user_condition": {
            "role": "deputy_dean"
          }
        },
        {
          "user_condition": {
            "role": "academic_staff"
          }
        },
        {
          "user_condition": {
            "role": "professor"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "faculty_admin"
              }
            },
            {
              "data.faculty_id": "{{user.data.faculty_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "department_head"
              }
            },
            {
              "data.department_id": "{{user.data.department_id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dean"
          }
        },
        {
          "user_condition": {
            "role": "deputy_dean"
          }
        },
        {
          "user_condition": {
            "role": "academic_staff"
          }
        },
        {
          "user_condition": {
            "role": "professor"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dean"
          }
        },
        {
          "user_condition": {
            "role": "deputy_dean"
          }
        },
        {
          "user_condition": {
            "role": "academic_staff"
          }
        },
        {
          "user_condition": {
            "role": "professor"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dean"
          }
        }
      ]
    }
  }
}