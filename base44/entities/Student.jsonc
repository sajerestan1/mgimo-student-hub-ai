{
  "name": "Student",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "faculty_id": {
      "type": "string"
    },
    "department_id": {
      "type": "string"
    },
    "program": {
      "type": "string"
    },
    "year": {
      "type": "number"
    },
    "group_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "enrollment_status": {
      "type": "string",
      "enum": [
        "active",
        "academic_leave",
        "graduated",
        "withdrawn"
      ],
      "enumColors": [
        "green",
        "yellow",
        "blue",
        "red"
      ],
      "default": "active"
    },
    "intervention_status": {
      "type": "string",
      "enum": [
        "none",
        "monitoring",
        "active"
      ],
      "enumColors": [
        "gray",
        "yellow",
        "red"
      ],
      "default": "none"
    },
    "is_demo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "full_name",
    "faculty_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dean"
          }
        },
        {
          "user_condition": {
            "role": "deputy_dean"
          }
        },
        {
          "user_condition": {
            "role": "academic_staff"
          }
        },
        {
          "user_condition": {
            "role": "professor"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "faculty_admin"
              }
            },
            {
              "data.faculty_id": "{{user.data.faculty_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "department_head"
              }
            },
            {
              "data.department_id": "{{user.data.department_id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dean"
          }
        },
        {
          "user_condition": {
            "role": "deputy_dean"
          }
        },
        {
          "user_condition": {
            "role": "academic_staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dean"
          }
        },
        {
          "user_condition": {
            "role": "deputy_dean"
          }
        },
        {
          "user_condition": {
            "role": "academic_staff"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dean"
          }
        }
      ]
    }
  }
}