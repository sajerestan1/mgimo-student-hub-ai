{
  "name": "Quiz",
  "type": "object",
  "properties": {
    "course_id": {
      "type": "string"
    },
    "course_code": {
      "type": "string"
    },
    "course_title": {
      "type": "string"
    },
    "professor_id": {
      "type": "string"
    },
    "module_number": {
      "type": "number"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "instructions": {
      "type": "string"
    },
    "duration_minutes": {
      "type": "number",
      "default": 20
    },
    "attempt_limit": {
      "type": "number",
      "default": 2
    },
    "pass_mark": {
      "type": "number",
      "default": 60
    },
    "available_from": {
      "type": "string"
    },
    "available_until": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "closed"
      ],
      "enumColors": [
        "gray",
        "green",
        "blue"
      ],
      "default": "draft"
    },
    "semester": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "course_id",
    "title",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "published"
        },
        {
          "data.status": "closed"
        },
        {
          "user_condition": {
            "role": "professor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dean"
          }
        },
        {
          "user_condition": {
            "role": "deputy_dean"
          }
        },
        {
          "user_condition": {
            "role": "academic_staff"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "professor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "professor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "professor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}