{
  "name": "StudentProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner of this profile"
    },
    "full_name": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "program": {
      "type": "string"
    },
    "faculty": {
      "type": "string"
    },
    "year": {
      "type": "number"
    },
    "university": {
      "type": "string",
      "description": "Institution the student has selected for policy and alert wording"
    },
    "email": {
      "type": "string"
    },
    "advisor": {
      "type": "string"
    },
    "preferences": {
      "type": "object",
      "description": "Academic alert preferences owned by the student. Essential account and security notifications are not controlled here.",
      "properties": {
        "course_performance_alerts": {
          "type": "boolean",
          "default": true
        },
        "overall_performance_alerts": {
          "type": "boolean",
          "default": true
        },
        "attendance_alerts": {
          "type": "boolean",
          "default": true
        },
        "threshold_alerts": {
          "type": "boolean",
          "default": true
        },
        "in_app_delivery": {
          "type": "boolean",
          "default": true
        },
        "email_delivery": {
          "type": "boolean",
          "default": false
        },
        "digest": {
          "type": "string",
          "enum": [
            "off",
            "daily",
            "weekly"
          ],
          "enumColors": [
            "gray",
            "blue",
            "green"
          ],
          "default": "off"
        }
      }
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}