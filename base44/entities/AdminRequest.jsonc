{
  "name": "AdminRequest",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "faculty_id": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "under_review",
        "awaiting_information",
        "approved",
        "rejected",
        "completed"
      ],
      "enumColors": [
        "blue",
        "yellow",
        "orange",
        "green",
        "red",
        "purple"
      ],
      "default": "submitted"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high"
      ],
      "enumColors": [
        "gray",
        "blue",
        "red"
      ],
      "default": "normal"
    },
    "assigned_to": {
      "type": "string"
    },
    "submitted_date": {
      "type": "string"
    },
    "due_date": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "category",
    "subject",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dean"
          }
        },
        {
          "user_condition": {
            "role": "deputy_dean"
          }
        },
        {
          "user_condition": {
            "role": "academic_staff"
          }
        },
        {
          "user_condition": {
            "role": "professor"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "faculty_admin"
              }
            },
            {
              "data.faculty_id": "{{user.data.faculty_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "department_head"
              }
            },
            {
              "data.faculty_id": "{{user.data.faculty_id}}"
            }
          ]
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dean"
          }
        },
        {
          "user_condition": {
            "role": "deputy_dean"
          }
        },
        {
          "user_condition": {
            "role": "academic_staff"
          }
        },
        {
          "user_condition": {
            "role": "faculty_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dean"
          }
        }
      ]
    }
  }
}