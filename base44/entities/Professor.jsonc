{
  "name": "Professor",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "faculty_id": {
      "type": "string"
    },
    "department_id": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "employment_status": {
      "type": "string",
      "enum": [
        "full_time",
        "part_time",
        "visiting"
      ],
      "enumColors": [
        "green",
        "yellow",
        "blue"
      ],
      "default": "full_time"
    },
    "hire_date": {
      "type": "string"
    },
    "weekly_hours": {
      "type": "number"
    },
    "is_demo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "full_name",
    "faculty_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dean"
          }
        },
        {
          "user_condition": {
            "role": "deputy_dean"
          }
        },
        {
          "user_condition": {
            "role": "academic_staff"
          }
        },
        {
          "user_condition": {
            "role": "professor"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "faculty_admin"
              }
            },
            {
              "data.faculty_id": "{{user.data.faculty_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "department_head"
              }
            },
            {
              "data.department_id": "{{user.data.department_id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dean"
          }
        },
        {
          "user_condition": {
            "role": "deputy_dean"
          }
        },
        {
          "user_condition": {
            "role": "academic_staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dean"
          }
        },
        {
          "user_condition": {
            "role": "deputy_dean"
          }
        },
        {
          "user_condition": {
            "role": "academic_staff"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dean"
          }
        }
      ]
    }
  }
}