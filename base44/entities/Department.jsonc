{
  "name": "Department",
  "type": "object",
  "properties": {
    "faculty_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "head_name": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "faculty_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dean"
          }
        },
        {
          "user_condition": {
            "role": "deputy_dean"
          }
        },
        {
          "user_condition": {
            "role": "academic_staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dean"
          }
        },
        {
          "user_condition": {
            "role": "deputy_dean"
          }
        },
        {
          "user_condition": {
            "role": "academic_staff"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dean"
          }
        }
      ]
    }
  }
}