{
  "name": "CommunicationMessage",
  "type": "object",
  "properties": {
    "thread_id": {
      "type": "string"
    },
    "group_id": {
      "type": "string"
    },
    "sender_user_id": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_role": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "text",
        "system"
      ],
      "enumColors": [
        "blue",
        "gray"
      ],
      "default": "text"
    },
    "reply_to_id": {
      "type": "string"
    },
    "reply_to_preview": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file_uri": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "mime": {
            "type": "string"
          },
          "size": {
            "type": "number"
          }
        }
      }
    },
    "mentions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pinned": {
      "type": "boolean",
      "default": false
    },
    "client_key": {
      "type": "string"
    },
    "moderation_status": {
      "type": "string",
      "enum": [
        "visible",
        "hidden",
        "removed"
      ],
      "enumColors": [
        "green",
        "yellow",
        "red"
      ],
      "default": "visible"
    },
    "moderation_note": {
      "type": "string"
    },
    "edited_at": {
      "type": "string"
    },
    "deleted_at": {
      "type": "string"
    }
  },
  "required": [
    "thread_id",
    "sender_user_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}