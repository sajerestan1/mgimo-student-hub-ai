{
  "name": "ClassSession",
  "type": "object",
  "properties": {
    "course_id": {
      "type": "string"
    },
    "course_code": {
      "type": "string"
    },
    "course_title": {
      "type": "string"
    },
    "professor_id": {
      "type": "string"
    },
    "group_name": {
      "type": "string"
    },
    "session_date": {
      "type": "string"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "room": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "lecture",
        "seminar",
        "practice"
      ],
      "enumColors": [
        "blue",
        "purple",
        "green"
      ],
      "default": "lecture"
    },
    "attendance_taken": {
      "type": "boolean",
      "default": false
    },
    "is_demo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "course_id",
    "session_date",
    "start_time"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "professor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "professor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "professor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}