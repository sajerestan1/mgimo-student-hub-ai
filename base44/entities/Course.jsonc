{
  "name": "Course",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "faculty_id": {
      "type": "string"
    },
    "department_id": {
      "type": "string"
    },
    "professor_id": {
      "type": "string"
    },
    "credits": {
      "type": "number"
    },
    "semester": {
      "type": "string"
    },
    "year_level": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "level": {
      "type": "string",
      "enum": [
        "foundation",
        "intermediate",
        "advanced"
      ],
      "enumColors": [
        "green",
        "blue",
        "purple"
      ],
      "default": "intermediate"
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "draft",
        "archived"
      ],
      "enumColors": [
        "green",
        "gray",
        "red"
      ],
      "default": "published"
    },
    "syllabus": {
      "type": "string"
    },
    "weight_assignments": {
      "type": "number",
      "default": 30
    },
    "weight_quizzes": {
      "type": "number",
      "default": 20
    },
    "weight_midterm": {
      "type": "number",
      "default": 20
    },
    "weight_final": {
      "type": "number",
      "default": 30
    },
    "is_demo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dean"
          }
        },
        {
          "user_condition": {
            "role": "deputy_dean"
          }
        },
        {
          "user_condition": {
            "role": "academic_staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dean"
          }
        },
        {
          "user_condition": {
            "role": "deputy_dean"
          }
        },
        {
          "user_condition": {
            "role": "academic_staff"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dean"
          }
        }
      ]
    }
  }
}