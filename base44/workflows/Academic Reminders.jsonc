{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "academic_reminders",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_reminders": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "academicReminders",
            "args": {
              "action": "run"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Send academic reminders",
            "description": "Deadlines, overdue work, attendance, performance and digests"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8,13,18 * * *",
      "one_time_date": null,
      "timezone": "America/Los_Angeles",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Academic Reminders",
  "description": "Three times a day, builds each student's deadline, overdue, attendance, performance and digest reminders from their own academic records and delivers them on the channels the student enabled."
}